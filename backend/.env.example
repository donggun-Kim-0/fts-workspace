# ── 서버 ─────────────────────────────────────────────
PORT=4000

# ── PostgreSQL ───────────────────────────────────────
# 로컬 Docker (backend/docker-compose.yml + npm run db:up)
DATABASE_URL="postgresql://fts_user:secure_password@localhost:5432/fts_prod?schema=public"

# 클라우드 (Render PostgreSQL 등) — sslmode=require 권장
# DATABASE_URL="postgresql://USER:PASSWORD@HOST.region-postgres.render.com/DATABASE?sslmode=require"

# ── CORS (프론트엔드 접속 URL, 쉼표 구분) ─────────────
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Vercel 프리뷰 배포(*.vercel.app) 허용 — 프로덕션에서는 false 권장
ALLOW_VERCEL_PREVIEW=false

# ── Geocoding (선택, 백엔드 주소→좌표 연동 시) ───────
GEOCODING_PROVIDER=kakao
GEOCODING_API_KEY=
